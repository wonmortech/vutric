    "share.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired device yet. Pair a computer or a phone in the Vutric app."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali juftlangan qurilma yoʻq. Vutric ilovasida kompyuter yoki telefonni ulang."
          }
        }
      }
    },
    "share.error.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekor qilindi"
          }
        }
      }
    },
    "share.error.declined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The receiver declined"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qabul qiluvchi rad etdi"
          }
        }
      }
    },
    "share.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not send"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuborib boʻlmadi"
          }
        }
      }
    },
    "share.error.not_paired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is no longer paired. Pair it again in Vutric."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qurilma endi juftlanmagan. Vutric ilovasida qayta ulang."
          }
        }
      }
    },
    "share.error.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{device} did not answer: is it on, and on this Wi-Fi?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "{device} javob bermadi: u yoqilganmi va shu Wi-Fi’dami?"
          }
        }
      }
    },
    "share.not_set_up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Vutric app once first."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval Vutric ilovasini bir marta oching."
          }
        }
      }
    },
