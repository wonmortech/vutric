          }
        }
      }
    },
    "bulk.too_big": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than 10 GB cannot go through the relay: use a phone hotspot or a cable"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay orqali 10 GB dan koʻp yuborilmaydi: telefon hotspoti yoki kabelni ishlating"
          }
        }
      }
    },
    "intent.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent {count} files to {device}"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} ta fayl {device}’ga yuborildi"
          }
        }
      }
    },
    "intent.error.no_files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No files to send"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuboriladigan fayl yoʻq"
          }
        }
      }
    },
