      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send to your last computer in one tap"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bosishda oxirgi kompyuterga yuborish"
