            "state": "translated",
            "value": "Close"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yopish"
          }
        }
      }
    },
    "share.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to {device}…"
          }
        },
        "uz": {
