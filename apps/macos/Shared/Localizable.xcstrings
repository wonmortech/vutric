{
  "sourceLanguage" : "uz",
  "version" : "1.0",
  "strings" : {
    "daemon.error.lost" : {
      "localizations" : {
        "uz" : { "stringUnit" : { "state" : "translated", "value" : "xizmat bilan aloqa uzildi" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "lost the connection to the service" } }
      }
    },
    "daemon.error.noanswer" : {
      "localizations" : {
        "uz" : { "stringUnit" : { "state" : "translated", "value" : "xizmat javob bermayapti" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "the service does not answer" } }
      }
    },
    "login.approve.body" : {
      "localizations" : {
        "uz" : { "stringUnit" : { "state" : "translated", "value" : "Tizim sozlamalari → Umumiy → Kirish elementlari bo'limida Vutric'ni yoqing." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn Vutric on in System Settings → General → Login Items." } }
      }
    },
    "login.approve.title" : {
      "localizations" : {
        "uz" : { "stringUnit" : { "state" : "translated", "value" : "macOS ruxsatingizni kutmoqda" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS is waiting for your approval" } }
      }
    },
    "menu.connect" : {
      "localizations" : {
        "uz" : { "stringUnit" : { "state" : "translated", "value" : "Telefonni ulash" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect a phone" } }
      }
    },
    "menu.login" : {
      "localizations" : {
        "uz" : { "stringUnit" : { "state" : "translated", "value" : "Kompyuter yonganda ishga tushsin" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open at login" } }
      }
    },
    "menu.pause" : {
      "localizations" : {
